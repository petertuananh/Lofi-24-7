<%- include("partials/header", { bot, user, path, title: "Select server" }) %>
<% if (bot.db.get(`colormode-${user.id}`) == 'checked') { %>

  <body class="text-white" style="background-color: white;">

<% } else { %>

  <body class="text-white" style="background-color: black;">

<% } %>

<div style="display: flex; flex-wrap: wrap; justify-content: center;">
  <% user.guilds.forEach(guild => {
      const permsOnGuild = new perms(guild.permissions_new);
      if(!permsOnGuild.has(perms.FLAGS.ADMINISTRATOR)) return;
  %>

    <div class="card" style="max-width: 18px; margin: 2rem; min-width: 10em; max-height: 350; background-color:transparent; text-align: center;">
    <%- guild.icon ? `<img src="https://cdn.discordapp.com/icons/${guild.id}/${guild.icon}" class="card-img-top guildAvt" style="max-width: 5rem;">` : `<img src="https://img.icons8.com/cute-clipart/512/000000/questions.png" class="card-img-top guildAvt" style="max-width: 5rem;">` %>
      <div class="card-body">
        <h5 style="color: #3bed53; text-align: center;" class="card-text"><%= guild.name %></h5>
        
        
      </div>
      <div>
        <% if (bot.guilds.cache.get(guild.id)) { %>
          <a href="/dashboard/<%- guild.id %>" class="btn btn-success text-white">Setting</a>
        <% } else { %>
          <a href="<%= `https://discordapp.com/oauth2/authorize?client_id=${bot.user.id}&scope=bot%20applications.commands&guild_id=${guild.id}&response_type=code&redirect_uri=${encodeURIComponent(`${bot.config.dashboard.domain}/callback`)}&scope=bot&permissions=8%20applications.commands`  %>" class="btn btn-primary text-white">Invite Bot</a>
        <% } %>
      </div>
    </div>
  <%
      });
  %>
</div>
</body>
<%- include("partials/footer") %>



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Example</title>
    <style>
        body{
            background-color: var(--gray);
        }
    </style>
</head>
</html>